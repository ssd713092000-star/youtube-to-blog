# Variables for docker-compose.yml (GCP mode). Copy to .env at the repo root.

GCP_PROJECT=your-project-id
CLOUD_SQL_INSTANCE=your-project-id:us-east1:tube2dev-pg

# Your Google account as a Cloud SQL IAM user, URL-encoded (@ -> %40)
DB_IAM_USER=you%40gmail.com

# Folder holding application_default_credentials.json
#   Windows: C:/Users/<you>/AppData/Roaming/gcloud
#   macOS/Linux: ~/.config/gcloud
GCLOUD_CONFIG_DIR=C:/Users/you/AppData/Roaming/gcloud

# Firebase web app config (public values). WEB_AUTH_MODE=dev to skip Firebase locally
# (then set AUTH_MODE=dev in backend/.env too).
WEB_AUTH_MODE=firebase
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_APP_ID=
