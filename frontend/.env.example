# Copy to frontend/.env.local for `npm run dev`. These are public (inlined into the browser bundle).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# firebase in deployed envs; dev = local backend with AUTH_MODE=dev (type any email to sign in)
NEXT_PUBLIC_AUTH_MODE=dev
NEXT_PUBLIC_RELEASE=dev

# Firebase web config (Firebase console -> Project settings -> Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=
