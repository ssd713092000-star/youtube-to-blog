# Copy to backend/.env for local runs. Never commit .env.
# GCP access uses Application Default Credentials: run `gcloud auth application-default login`.

ENV=local
LOG_LEVEL=INFO
GCP_PROJECT=your-project-id
REGION=us-east1

# Cloud SQL through the Auth Proxy with --auto-iam-authn (no password).
# The IAM DB user for your own Google account is your email address.
APP_DB_URL=postgresql+psycopg://you%40gmail.com@127.0.0.1:5432/tube2dev_app
CREDS_DB_URL=postgresql+psycopg://you%40gmail.com@127.0.0.1:5432/tube2dev_credentials

GCS_BUCKET=your-project-id-tube2dev-content
KMS_KEY_NAME=projects/your-project-id/locations/us-east1/keyRings/tube2dev/cryptoKeys/user-api-keys

# inline = run graph segments inside the API process (local only). cloud_tasks in stage/prod.
TASK_MODE=inline
TASKS_QUEUE=graph-runs
TASKS_INVOKER_SA=sa-tasks-invoker@your-project-id.iam.gserviceaccount.com
WORKER_URL=http://localhost:8001

# firebase in stage/prod. dev accepts "Authorization: Bearer dev:<email>" (local only).
AUTH_MODE=firebase
FIREBASE_PROJECT_ID=your-project-id
WEB_ORIGINS=http://localhost:3000

# YouTube blocks cloud IPs; set one of these for deployed environments.
# Secret holds {"username": "...", "password": "..."} for Webshare.
YT_PROXY_SECRET=
# YT_PROXY_SECRET=projects/your-project-id/secrets/yt-proxy-credentials/versions/latest
YT_PROXY_URL=

DEFAULT_MODEL=deepseek/deepseek-v4.1-flash
DEFAULT_BUDGET_USD=0.50
DAILY_JOB_QUOTA=10

# Comma-separated IAM DB users the migrate job grants runtime access to.
DB_APP_GRANTEES=sa-api@your-project-id.iam,sa-worker@your-project-id.iam
DB_CREDS_GRANTEES=sa-api@your-project-id.iam,sa-worker@your-project-id.iam

# Optional LangSmith tracing
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=tube2dev
